# ---------- API protection ----------
# Every endpoint except /health requires the header  X-API-Key: <API_KEY>
# Generate one with:  openssl rand -hex 32
API_KEY=
# Docker port binding: 127.0.0.1 = only from the VPS itself, 0.0.0.0 = from the internet
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# ---------- Wialon ----------
# Remote API token (admin endpoints only: list units, register a unit's IMEI)
WIALON_TOKEN=
WIALON_BASE_URL=https://hst-api.wialon.com
# IPS server (hw_gw_ip from token/login) and the port of the "Wialon IPS" device type
WIALON_IPS_HOST=193.193.165.165
WIALON_IPS_PORT=20332
IPS_PING_INTERVAL=60

# ---------- Jimi / TrackSolid Pro bridge ----------
#   webhook = Jimi pushes Tag positions to us (default; no Jimi API calls)
#   poll    = we poll the Jimi Open API (needs JIMI_APP_KEY ... below)
#   off     = bridge disabled
JIMI_MODE=webhook

# Optional secret for the webhook URL. When set, Jimi must call either
#   http(s)://<host>/<WEBHOOK_TOKEN>/api/v1/tag/data/push
#   http(s)://<host>/api/v1/tag/data/push?token=<WEBHOOK_TOKEN>
# Generate one with:  openssl rand -hex 16
WEBHOOK_TOKEN=

# ---------- public webhook entry point (Caddy) ----------
# COMPOSE_PROFILES=proxy starts a Caddy container that exposes ONLY the webhook and /health
# on ONE port (PROXY_PORT). The host's ports 80/443 are never used, so an existing
# Apache/Nginx is not affected.
COMPOSE_PROFILES=proxy
PROXY_PORT=8443
#   http  = plain HTTP on PROXY_PORT
#   https = HTTPS on PROXY_PORT, reusing an existing Let's Encrypt certificate (certbot)
CADDY_CONFIG=https
WEBHOOK_DOMAIN=tagdata.camtrack.net
# folder name under /etc/letsencrypt/live/ (defaults to WEBHOOK_DOMAIN)
CERT_NAME=
LETSENCRYPT_DIR=/etc/letsencrypt

# ---------- poll mode only ----------
JIMI_BASE_URL=https://eu-open.tracksolidpro.com/route/rest
JIMI_APP_KEY=
JIMI_APP_SECRET=
JIMI_ACCOUNT=
# lowercase MD5 of the account password (or JIMI_PASSWORD with the plain one)
JIMI_PASSWORD_MD5=
BRIDGE_POLL_INTERVAL=180
BRIDGE_BACKFILL_HOURS=24
BRIDGE_OVERLAP_MINUTES=120

LOG_LEVEL=INFO
