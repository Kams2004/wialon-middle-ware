# ---------- API protection ----------
# Every endpoint except /health requires the header  X-API-Key: <API_KEY>
# Generate one with:  openssl rand -hex 32
API_KEY=
# Docker port binding: 127.0.0.1 = only from the VPS itself, 0.0.0.0 = from the internet
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# ---------- Wialon ----------
# Remote API token (admin endpoints only: list units, register a unit's IMEI)
WIALON_TOKEN=
WIALON_BASE_URL=https://hst-api.wialon.com
# IPS server (hw_gw_ip from token/login) and the port of the "Wialon IPS" device type
WIALON_IPS_HOST=193.193.165.165
WIALON_IPS_PORT=20332
IPS_PING_INTERVAL=60

# ---------- Jimi / TrackSolid Pro bridge ----------
#   webhook = Jimi pushes Tag positions to us (default; no Jimi API calls)
#   poll    = we poll the Jimi Open API (needs JIMI_APP_KEY ... below)
#   hybrid  = poll, with the webhook on standby; the first push for one of our Tags
#             switches polling off automatically (remembered across restarts)
#   off     = bridge disabled
JIMI_MODE=webhook

# Public hostname of the webhook (used by scripts/webhook-url.sh)
WEBHOOK_DOMAIN=tagdata.camtrack.net
# Optional secret in the webhook URL (/<token>/api/v1/tag/data/push or ?token=). Empty = no token.
WEBHOOK_TOKEN=
# Extra IMEIs allowed to be sent to Wialon (comma separated). Tags seen through Jimi polling are
# allowed automatically; anything else is kept but never sent (see README "IMEI allowlist").
ALLOWED_IMEIS=

# ---------- public entry point ----------
# Default: the host's Apache serves https://WEBHOOK_DOMAIN and forwards the webhook to
# 127.0.0.1:8000 (deploy/apache/). Leave COMPOSE_PROFILES empty.
# Alternative without Apache: COMPOSE_PROFILES=proxy starts Caddy on its own PROXY_PORT.
COMPOSE_PROFILES=
PROXY_PORT=8443
#   http / https (https reuses an existing certbot certificate for WEBHOOK_DOMAIN)
CADDY_CONFIG=https
CERT_NAME=
LETSENCRYPT_DIR=/etc/letsencrypt

# ---------- poll / hybrid mode only ----------
JIMI_BASE_URL=https://eu-open.tracksolidpro.com/route/rest
JIMI_APP_KEY=
JIMI_APP_SECRET=
JIMI_ACCOUNT=
# lowercase MD5 of the account password (or JIMI_PASSWORD with the plain one)
JIMI_PASSWORD_MD5=
BRIDGE_POLL_INTERVAL=180
BRIDGE_BACKFILL_HOURS=24
BRIDGE_OVERLAP_MINUTES=120

LOG_LEVEL=INFO
