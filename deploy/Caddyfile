# Public entry point. Only the Jimi webhook and /health are reachable from the
# internet; every other endpoint stays private on the VPS (127.0.0.1:8000).
# Caddy listens on :80 inside the container; docker-compose publishes it on the host's
# PROXY_HTTP_PORT (default 8090), never on the host's 80/443.
{$SITE_ADDRESS} {
	@webhook path_regexp ^/([A-Za-z0-9_-]+/)?api/v1/tag/data/push/?$
	handle @webhook {
		request_body {
			max_size 2MB
		}
		reverse_proxy middleware:8000
	}
	handle /health {
		reverse_proxy middleware:8000
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format console
	}
}
